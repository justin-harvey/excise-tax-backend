# Copy to .env.docker and set real values before running docker-compose up.
# docker-compose.yml requires every one of these (no built-in defaults) -
# see SECURITY_FIXES_APPLIED.md, fix #2. Generate strong values, e.g.:
#   openssl rand -base64 32

POSTGRES_PASSWORD=<generate-a-strong-random-password>
REDIS_PASSWORD=<generate-a-strong-random-password>
RABBITMQ_PASSWORD=<generate-a-strong-random-password>
GRAFANA_ADMIN_PASSWORD=<generate-a-strong-random-password>

# =============================================================================
# Excise Tax Portal - Environment Configuration Template
# =============================================================================
# SECURITY WARNING: This file contains sensitive credentials!
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate strong passwords (see examples below)
# 3. Update all placeholder values
# 4. NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_16_CHARS
POSTGRES_DB=excise_tax_db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_MIN_32_CHARS
JWT_ACCESS_TOKEN_DURATION=1h
JWT_REFRESH_TOKEN_DURATION=168h

# -----------------------------------------------------------------------------
# Database Connection (for services)
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_16_CHARS
DB_NAME=excise_tax_db
DB_SSLMODE=disable

# -----------------------------------------------------------------------------
# Password Generation Examples
# -----------------------------------------------------------------------------
# PowerShell (Windows):
#   Add-Type -AssemblyName System.Web
#   [System.Web.Security.Membership]::GeneratePassword(32,8)
#
# Bash/zsh (Linux/Mac):
#   openssl rand -base64 32
#
# Or use online generator: https://passwordsgenerator.net/
# Recommended: 32+ characters, mixed case, numbers, symbols
# -----------------------------------------------------------------------------

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production:
# [ ] All passwords changed from defaults
# [ ] JWT_SECRET is strong and unique (32+ chars)
# [ ] .env is in .gitignore
# [ ] Passwords stored in password manager
# [ ] Different passwords for each service
# [ ] APP_ENV set to "production"
# [ ] LOG_LEVEL set to "info" or "warn"
# [ ] SSL/TLS certificates configured
# [ ] Firewall rules configured
# [ ] Backup strategy in place
# [ ] Monitoring and alerting configured
# =============================================================================

# Environment variables for excise-tax-backend v2

# PostgreSQL Database Configuration
POSTGRES_DB=excise_tax_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# API Configuration
API_PORT=8080
ENV=development

# XRPL Configuration
XRPL_URL=wss://s.altnet.rippletest.net:51233

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# JWT Configuration (for legacy services)
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_TOKEN_DURATION=1h
JWT_REFRESH_TOKEN_DURATION=168h
